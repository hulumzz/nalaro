---
import Base from "../layouts/Base.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
---
<Base title="Halaman tidak ditemukan | Nalaro" description="Halaman yang kamu cari tidak tersedia. Kembali ke beranda untuk menjelajahi produk Nalaro." noindex>
  <Header />
  <main id="main-content" class="not-found container"><p class="eyebrow">HALAMAN TIDAK DITEMUKAN</p><span class="error-code" aria-hidden="true">404<span class="orange">.</span></span><h1>Sepertinya kamu salah belok.</h1><p>Halaman ini sudah berpindah atau memang belum ada.</p><a href="/" class="button button-primary">Kembali ke beranda <span aria-hidden="true">↗</span></a></main>
  <Footer />
</Base>
