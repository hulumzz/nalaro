---
import Index from "../ui/Index.astro";
import DataRow from "../ui/DataRow.astro";
import StatusSquare from "../glyph/StatusSquare.astro";
import BracketLink from "../ui/BracketLink.astro";
import { pipelineStages } from "../../data/pipeline";
---

<section id="lab" class="relative w-full section-pad bg-[var(--color-bone)]" data-section="lab" data-surface="bone">
  <div class="grid-content pb-12 lg:pb-16">
    <div class="col-span-full lg:col-start-2 lg:col-span-11 flex flex-col gap-6">
      <Index number="04" name="Lab" class="mb-4" />
      <h2 class="t-h2 text-[var(--color-ink)] w-wide">Lab</h2>
      <p class="t-lede text-[var(--color-ink)] opacity-80 max-w-2xl">Tempat ide diuji sebelum jadi produk.</p>
    </div>
  </div>

  {/* Pipeline Strip */}
  <div class="w-full border-y border-ink-soft overflow-x-auto no-scrollbar relative">
    <div class="absolute left-0 top-1/2 w-full h-[1px] line-ink-soft -translate-y-1/2 z-0"></div>
    <div class="grid-content relative z-10 py-6 min-w-[800px]">
      <div class="col-span-full lg:col-start-2 lg:col-span-11 flex justify-between">
        {pipelineStages.map((stage, i) => (
          <div class="flex flex-col items-center gap-4 bg-[var(--color-bone)] px-4">
            <span class="t-label text-[var(--color-ink)]">{stage.label}</span>
            <div class="w-[10px] h-[10px] border border-[var(--color-ink)] bg-[var(--color-bone)] relative flex items-center justify-center">
              {i > 0 && i < pipelineStages.length - 1 && (
                <div class="w-full h-full bg-[var(--color-ink)] opacity-100 transform origin-left"></div>
              )}
              {i === pipelineStages.length - 1 && (
                <div class="w-[14px] h-[14px] bg-[var(--color-flare)] absolute -z-10 animate-pulse"></div>
              )}
            </div>
            <span class="t-label text-[var(--color-mute-b)]">0 ENTRI</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  {/* Lab Log List */}
  <div class="w-full lg:pl-[64px]">
    {/* Empty State per PRD */}
    <div class="w-full border-b border-ink-medium border-dashed p-6 sm:p-8 lg:p-12 flex flex-col items-start justify-center text-left gap-4 surface-bone-2-soft mt-8">
      <span class="t-label text-[var(--color-mute-b)] border border-[var(--color-mute-b)] px-3 py-1">BELUM ADA ENTRI</span>
      <p class="t-body text-[var(--color-ink)] opacity-80">Eksperimen pertama sedang berjalan.</p>
    </div>
    
    {/* Log Table Header (Hidden on mobile) */}
    <div class="hidden lg:grid grid-cols-12 border-b border-ink-soft p-4">
      <div class="col-span-2"><span class="t-label text-[var(--color-mute-b)]">TANGGAL</span></div>
      <div class="col-span-3"><span class="t-label text-[var(--color-mute-b)]">NAMA</span></div>
      <div class="col-span-5"><span class="t-label text-[var(--color-mute-b)]">DESKRIPSI</span></div>
      <div class="col-span-2 text-right"><span class="t-label text-[var(--color-mute-b)]">STATUS</span></div>
    </div>

    {/* Note: The actual rows will be generated from Astro Content Collections when entries exist.
        For now, we just show the empty state as instructed in PRD §12.
    */}
  </div>
</section>
