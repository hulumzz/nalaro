---
import { home } from "../../data/home";
---
<section id="lab" class="lab-section container" aria-labelledby="lab-title">
  <div class="lab-copy"><p class="eyebrow"><span class="section-number">04</span>{home.lab.label}</p><h2 id="lab-title">{home.lab.title}</h2><p>{home.lab.text}</p></div>
  <div class="lab-flow"><ol>{home.lab.stages.map((stage, i) => <li><span class="lab-node" aria-hidden="true">{i === 3 ? "↗" : "+"}</span><span>{stage}</span></li>)}</ol><p class="muted">{home.lab.note}</p></div>
</section>
