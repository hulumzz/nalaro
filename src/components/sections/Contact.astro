---
import { site } from "../../data/site";
import { home } from "../../data/home";
const connected = Boolean(site.email || site.whatsapp);
---
<section id="contact" class="contact-section" aria-labelledby="contact-title">
  <div class="container contact-grid"><div class="contact-copy"><p class="eyebrow"><span class="section-number">06</span>{home.contact.label}</p><h2 id="contact-title" data-reveal>{home.contact.title}</h2><p>{home.contact.text}</p>
    <div class="contact-links">{site.email && <a href={`mailto:${site.email}`}>{site.email}<span aria-hidden="true">↗</span></a>}{site.whatsapp && <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener noreferrer">Chat via WhatsApp<span aria-hidden="true">↗</span></a>}<a href="https://order.nalaro.digital/form/" target="_blank" rel="noopener noreferrer">Form order<span aria-hidden="true">↗</span></a></div>
    {site.email && <button type="button" class="copy-email" data-email={site.email}>Salin email</button>}
  </div>
  <form id="contact-form" class="contact-form" data-email={site.email} data-whatsapp={site.whatsapp}>
    <label for="contact-name">Namamu</label><input id="contact-name" name="name" autocomplete="name" maxlength="100" placeholder="Bagaimana kami menyapamu?" required aria-describedby="name-error"/><span class="form-error" id="name-error" hidden>Isi namamu terlebih dahulu.</span>
    <fieldset><legend>Apa yang ingin kamu bahas?</legend><div class="contact-options">{["Produk", "Solusi khusus", "Kolaborasi", "Lainnya"].map((need, i) => <label><input type="radio" name="need" value={need} checked={i === 0}/><span>{need}</span></label>)}</div></fieldset>
    <label for="contact-message">Ceritakan sedikit</label><textarea id="contact-message" name="message" rows="3" maxlength="4000" placeholder="Apa yang ingin dibuat atau diperbaiki?" required aria-describedby="message-error"></textarea><span class="form-error" id="message-error" hidden>Ceritakan kebutuhanmu terlebih dahulu.</span>
    <p class="contact-note">{connected ? home.contact.note : home.contact.offline}</p>
    <div class="contact-actions">{site.email && <button class="button button-dark" type="submit" name="channel" value="email">Kirim lewat email<span aria-hidden="true">↗</span></button>}{site.whatsapp && <button class="button button-dark" type="submit" name="channel" value="whatsapp">Kirim lewat WhatsApp<span aria-hidden="true">↗</span></button>}{!connected && <button class="button button-dark" type="submit" name="channel" value="download">Simpan ringkasan<span aria-hidden="true">↓</span></button>}</div>
    <p class="form-status" role="status"></p>
    <noscript><p>Aktifkan JavaScript untuk menyusun ringkasan melalui formulir ini.</p></noscript>
  </form></div>
</section>
<script>
  const form = document.querySelector<HTMLFormElement>("#contact-form")!;
  form.noValidate = true;
  form.addEventListener("submit", event => {
    event.preventDefault();
    const name = form.elements.namedItem("name") as HTMLInputElement;
    const message = form.elements.namedItem("message") as HTMLTextAreaElement;
    const validName = name.value.trim().length > 0;
    const validMessage = message.value.trim().length > 0;
    document.querySelector<HTMLElement>("#name-error")!.hidden = validName;
    document.querySelector<HTMLElement>("#message-error")!.hidden = validMessage;
    name.setAttribute("aria-invalid", String(!validName));
    message.setAttribute("aria-invalid", String(!validMessage));
    if (!validName || !validMessage) { (!validName ? name : message).focus(); return; }
    const need = new FormData(form).get("need");
    const text = `Halo Nalaro,\n\nSaya ${name.value.trim()}. Saya ingin membahas ${need}.\n\n${message.value.trim()}`;
    const channel = (event.submitter as HTMLButtonElement | null)?.value || (form.dataset.email ? "email" : form.dataset.whatsapp ? "whatsapp" : "download");
    if (channel === "email" && form.dataset.email) {
      window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent("Diskusi " + need + " bersama " + name.value.trim())}&body=${encodeURIComponent(text)}`;
    } else if (channel === "whatsapp" && form.dataset.whatsapp) {
      window.open(`https://wa.me/${form.dataset.whatsapp}?text=${encodeURIComponent(text)}`, "_blank", "noopener,noreferrer");
    } else {
      const url = URL.createObjectURL(new Blob([text], { type: "text/plain;charset=utf-8" }));
      const link = document.createElement("a"); link.href = url; link.download = "ringkasan-proyek-nalaro.txt"; link.click();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
      form.querySelector(".form-status")!.textContent = "Ringkasan disimpan ke perangkatmu. Belum ada pesan yang dikirim.";
    }
  });
  const copy = document.querySelector<HTMLButtonElement>(".copy-email");
  copy?.addEventListener("click", async () => {
    try { await navigator.clipboard.writeText(copy.dataset.email!); copy.textContent = "Email tersalin"; }
    catch { copy.textContent = "Salin alamat email di atas"; }
    setTimeout(() => { copy.textContent = "Salin email"; }, 2500);
  });
</script>
