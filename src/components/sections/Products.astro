---
import { products } from "../../data/products";
import { home } from "../../data/home";
const ids = ["skripzy", "class", "enveely"];
const categories = ["RESEARCH & WRITING", "EDUCATION & LEARNING", "INVITATION & EVENTS"];
---
<section id="products" class="section container" aria-labelledby="products-title">
  <div class="section-heading"><div><p class="eyebrow"><span class="section-number">01</span>{home.products.label}</p><h2 id="products-title" data-reveal>{home.products.title}</h2></div><p class="section-intro">{home.products.intro}</p></div>
  <div class="product-grid">
    {products.filter(p => !p.isSlot).map((product, i) => <article id={`product-${ids[i]}`} class={`product-card product-${ids[i]}`}>
      <div class="product-art" aria-hidden="true">
        <div class="art-topline"><span>{categories[i]}</span><span>↗</span></div>
        {i === 0 && <div class="research-art"><div class="research-sidebar"><i></i><i></i><i></i><i></i></div><div class="research-paper"><span class="art-small">RUANG PENELITIAN</span><strong>Mulai dari<br/>rasa ingin tahu.</strong><div class="paper-lines"><i></i><i></i><i></i></div><div class="research-prompt"><span>✳</span> Bantu susun ide penelitian<span class="art-cursor"></span></div><div class="paper-lines short"><i></i><i></i></div></div></div>}
        {i === 1 && <div class="class-art"><div class="class-label"><span>RUANG KELAS</span><span>01 / 04</span></div><strong>Belajar. Coba.<br/>Pahami.</strong><div class="answer-grid"><span>A <i></i></span><span class="chosen">B <b>✓</b></span><span>C <i></i></span><span>D <i></i></span></div><div class="class-progress"><i></i><i></i><i></i><i></i></div></div>}
        {i === 2 && <div class="invite-art">
          <svg class="envelope-illustration" viewBox="0 0 320 220" fill="none" aria-hidden="true">
            <path d="M28 108 160 24 292 108V204H28Z" fill="#24251F" stroke="#55574C"/>
            <path d="m28 108 132 80 132-80" stroke="#55574C"/>
            <g class="envelope-letter">
              <path d="M65 12H255V187H65Z" fill="#E9E6DD" stroke="#DAD6CA"/>
              <path d="M75 22H245V177H75Z" stroke="#BBB7A9" stroke-width=".6"/>
              <text x="88" y="43" fill="#5F625B" font-size="7" letter-spacing="1.3" font-family="var(--font-mono)">SEBUAH CERITA BARU</text>
              <text x="88" y="76" fill="#151613" font-size="25" font-family="Georgia,serif">Untuk momen</text>
              <text x="88" y="104" fill="#151613" font-size="25" font-family="Georgia,serif">berhargamu.</text>
              <path d="M88 121H117" stroke="#FF5B2E" stroke-width="2"/>
              <path d="M225 36v15m-7.5-7.5h15m-13-5.5 11 11m0-11-11 11" stroke="#FF5B2E" stroke-width="1.2"/>
            </g>
            <path d="M28 108 160 172 292 108V204H28Z" fill="#35372D" stroke="#606253"/>
            <path d="m28 204 101-81m163 81-101-81" stroke="#55574A"/>
            <path d="m28 204 105-70q27-18 54 0l105 70" fill="#414336" stroke="#606253"/>
            <text x="46" y="188" fill="#F5F5F2" font-family="Georgia,serif" font-size="18">enveely</text>
            <path d="M251 176h13v13m-13 0 13-13" stroke="#FF5B2E" stroke-width="1.5"/>
          </svg>
        </div>}
        <span class="art-caption">Gambaran produk</span>
      </div>
      <div class="product-info"><div class="product-meta"><span class="mono">{product.code}</span><span class="product-status"><span class="signal"></span>{product.status === "Coming Soon" ? "Segera hadir" : product.status === "Live" ? "Tersedia" : product.status}</span></div><h3>{product.name}</h3><p>{product.description}</p>
        {product.url && <a class="product-open text-link" href={product.url} target="_blank" rel="noopener noreferrer">Buka {product.name} <span aria-hidden="true">↗</span></a>}
        <details class="product-details"><summary>Fitur dan fokus<span aria-hidden="true">+</span></summary><div><ul>{product.focus.map(focus => <li>{focus}</li>)}</ul></div></details>
      </div>
    </article>)}
  </div>
  <div class="product-next"><span><span class="orange" aria-hidden="true">+</span>{home.products.next}</span><a href="#lab" class="text-link">{home.products.nextLink}<span aria-hidden="true">↗</span></a></div>
</section>
