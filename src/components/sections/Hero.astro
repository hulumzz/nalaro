---
import { site } from "../../data/site";
import { home } from "../../data/home";
import BuildTerminal from "./BuildTerminal.astro";
---
<section id="index" class="hero container" aria-labelledby="hero-title">
  <div class="hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{home.hero.eyebrow} <img id="hero-ghost" src="/brand/nalaro-ghost-mascot-thin-v2.svg" alt="" aria-hidden="true" style="height: 48px; width: auto; margin-left: 4px; margin-top: -12px; margin-bottom: -12px; position: relative; z-index: 10;" /></p>
      <div class="hero-heading-wrap">
        <h1 id="hero-title" aria-label={site.headline}><span>WE BUILD</span><span class="hero-accent">BETTER<span class="asterisk" aria-hidden="true">✳</span></span><span>DIGITAL</span><span>PRODUCTS<span class="orange">.</span></span></h1>
        <svg class="hero-orbit" viewBox="0 0 84 84" fill="none" aria-hidden="true" focusable="false">
          <circle cx="42" cy="42" r="27" stroke="currentColor" stroke-width="1"/>
          <circle cx="42" cy="42" r="15" stroke="currentColor" stroke-width="1" opacity=".46"/>
          <path d="M42 0V18M42 66V84M0 42H18M66 42H84" stroke="currentColor" stroke-width="1.5"/>
          <path d="M56 28 63 21M21 63 28 56" stroke="currentColor" stroke-width="1" opacity=".6"/>
          <circle cx="42" cy="42" r="3" fill="currentColor"/>
        </svg>
      </div>
      <p class="hero-description">{site.subheadline}</p>
      <div class="hero-actions"><a href="#products" class="button button-primary">{site.ctaPrimary}<span aria-hidden="true">↗</span></a><a href="#contact" class="text-link">{site.ctaSecondary}<span aria-hidden="true">↗</span></a></div>
    </div>
    <div class="hero-visual"><div class="visual-caption"><span class="mono">IDEA INTO ACTION</span><span class="demo-label">Nalaro is building...</span></div><BuildTerminal /><p class="visual-note"><span aria-hidden="true">↳</span>{home.hero.note}</p></div>
  </div>
  <div class="hero-bottom"><span>{home.hero.productsLabel}</span><div><a href="#product-skripzy">Skripzy AI</a><span aria-hidden="true">/</span><a href="#product-class">Nalaro Class</a><span aria-hidden="true">/</span><a href="#product-enveely">Enveely</a><span aria-hidden="true">/</span><a href="#product-store">Nalaro Store</a></div><a href="#products" class="scroll-link" aria-label="Gulir ke produk"><span aria-hidden="true">↓</span></a></div>
</section>

<style is:global>
  #hero-ghost {
    will-change: transform;
    animation: ghost-flight 18s infinite;
  }
  
  @keyframes ghost-flight {
    0%, 15% { transform: translate(0, 0) scale(1) rotate(0deg); animation-timing-function: ease-in; }
    21% { transform: translate(12vw, -25px) scale(1.05) rotate(5deg); animation-timing-function: linear; }
    27% { transform: translate(24vw, -40px) scale(1.1) rotate(10deg); animation-timing-function: linear; }
    33% { transform: translate(36vw, -45px) scale(1.15) rotate(12deg); animation-timing-function: linear; }
    39% { transform: translate(45vw, -30px) scale(1.2) rotate(8deg); animation-timing-function: linear; }
    45% { transform: translate(48vw, 0px) scale(1.25) rotate(0deg); animation-timing-function: linear; }
    51% { transform: translate(45vw, 30px) scale(1.2) rotate(-8deg); animation-timing-function: linear; }
    57% { transform: translate(36vw, 45px) scale(1.15) rotate(-12deg); animation-timing-function: linear; }
    63% { transform: translate(24vw, 40px) scale(1.1) rotate(-10deg); animation-timing-function: linear; }
    69% { transform: translate(12vw, 25px) scale(1.05) rotate(-5deg); animation-timing-function: ease-out; }
    75%, 100% { transform: translate(0, 0) scale(1) rotate(0deg); animation-timing-function: ease-in-out; }
  }

  @media (max-width: 1000px) {
    @keyframes ghost-flight {
      0%, 15% { transform: translate(0, 0) scale(1) rotate(0deg); animation-timing-function: ease-in; }
      21% { transform: translate(15vw, -25px) scale(1.05) rotate(5deg); animation-timing-function: linear; }
      27% { transform: translate(30vw, -40px) scale(1.1) rotate(10deg); animation-timing-function: linear; }
      33% { transform: translate(45vw, -45px) scale(1.15) rotate(12deg); animation-timing-function: linear; }
      39% { transform: translate(56vw, -30px) scale(1.2) rotate(8deg); animation-timing-function: linear; }
      45% { transform: translate(60vw, 0px) scale(1.25) rotate(0deg); animation-timing-function: linear; }
      51% { transform: translate(56vw, 30px) scale(1.2) rotate(-8deg); animation-timing-function: linear; }
      57% { transform: translate(45vw, 45px) scale(1.15) rotate(-12deg); animation-timing-function: linear; }
      63% { transform: translate(30vw, 40px) scale(1.1) rotate(-10deg); animation-timing-function: linear; }
      69% { transform: translate(15vw, 25px) scale(1.05) rotate(-5deg); animation-timing-function: ease-out; }
      75%, 100% { transform: translate(0, 0) scale(1) rotate(0deg); animation-timing-function: ease-in-out; }
    }
  }

</style>

