---
import { site } from "../../data/site";
import { home } from "../../data/home";
import BuildTerminal from "./BuildTerminal.astro";
---
<section id="index" class="hero container" aria-labelledby="hero-title">
  <div class="hero-grid">
    <div class="hero-copy">
      <p class="eyebrow"><span class="signal"></span>{home.hero.eyebrow} <img src="/brand/nalaro-ghost-mascot-thin-v2.svg" alt="" aria-hidden="true" style="height: 48px; width: auto; margin-left: 4px; margin-top: -12px; margin-bottom: -12px;" /></p>
      <h1 id="hero-title" aria-label={site.headline}><span>WE BUILD</span><span class="hero-useful">USEFUL<span class="asterisk" aria-hidden="true">✳</span></span><span>DIGITAL</span><span>PRODUCTS<span class="orange">.</span></span></h1>
      <p class="hero-description">{site.subheadline}</p>
      <div class="hero-actions"><a href="#products" class="button button-primary">{site.ctaPrimary}<span aria-hidden="true">↗</span></a><a href="#contact" class="text-link">{site.ctaSecondary}<span aria-hidden="true">↗</span></a></div>
    </div>
    <div class="hero-visual"><div class="visual-caption"><span class="mono">IDEA INTO ACTION</span><span class="demo-label">Nalaro is building...</span></div><BuildTerminal /><p class="visual-note"><span aria-hidden="true">↳</span>{home.hero.note}</p></div>
  </div>
  <div class="hero-bottom"><span>{home.hero.productsLabel}</span><div><a href="#product-skripzy">Skripzy AI</a><span aria-hidden="true">/</span><a href="#product-class">Nalaro Class</a><span aria-hidden="true">/</span><a href="#product-enveely">Enveely</a></div><a href="#products" class="scroll-link" aria-label="Gulir ke produk"><span aria-hidden="true">↓</span></a></div>
</section>
