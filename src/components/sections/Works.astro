---
import { home, processSteps } from "../../data/home";
---
<section id="works" class="section container" aria-labelledby="process-title">
  <div class="section-heading"><div><p class="eyebrow"><span class="section-number">03</span>{home.process.label}</p><h2 id="process-title" data-reveal>{home.process.title}</h2></div><p class="section-intro">{home.process.intro}</p></div>
  <ol class="process-grid">{processSteps.map((step, i) => <li><div class="process-track"><span class="process-number">0{i + 1}</span><span class="mono">{step.label}</span><span class="process-arrow" aria-hidden="true">↗</span></div><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol>
  <div class="case-note"><div><h3>{home.process.caseTitle}</h3><p>{home.process.caseText}</p></div><a href="#products" class="text-link">{home.process.caseLink}<span aria-hidden="true">↗</span></a></div>
</section>
