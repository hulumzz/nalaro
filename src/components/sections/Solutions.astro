---
import { solutions } from "../../data/solutions";
import { home } from "../../data/home";
---
<section id="solutions" class="section section-surface" aria-labelledby="solutions-title">
  <div class="container solutions-grid">
    <div class="solutions-intro"><p class="eyebrow"><span class="section-number">02</span>{home.solutions.label}</p><h2 id="solutions-title" data-reveal>{home.solutions.title}</h2><p class="section-intro">{home.solutions.intro}</p><a href="#contact" class="text-link">Ceritakan kebutuhanmu<span aria-hidden="true">↗</span></a>
      <div class="system-map" aria-label="Tim, data, dan aktivitas terhubung dalam satu sistem">
        <div class="map-top"><span>TIM</span><span>DATA</span><span>AKTIVITAS</span></div>
        <div class="map-connectors" aria-hidden="true"><i></i><i></i><i></i></div>
        <div class="map-core"><img src="/brand/nalaro.png" width="32" height="32" alt="" /><span>Satu sistem yang terhubung</span><span class="signal"></span></div>
        <div class="map-output"><span aria-hidden="true">↓</span><span>{home.solutions.visualLabel}</span></div>
      </div>
    </div>
    <div class="solution-list">{solutions.map((solution, i) => <details class="solution-item" name="solutions" open={i === 0}><summary><span class="mono orange">{solution.code}</span><h3>{solution.name}</h3><span class="detail-plus" aria-hidden="true">+</span></summary><div class="solution-content"><p>{solution.description}</p><div class="solution-flow"><div><span class="mono muted">DARI</span><p>{solution.input}</p></div><span class="orange" aria-hidden="true">↳</span><div><span class="mono muted">MENJADI</span><p>{solution.output}</p></div></div><ul class="solution-tags">{solution.tags.map(tag => <li>{tag}</li>)}</ul></div></details>)}
      <p class="audience-note">{home.solutions.audiences}</p>
    </div>
  </div>
</section>
