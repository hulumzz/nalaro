---
import { site, nav } from "../../data/site";
import { products } from "../../data/products";
const year = new Date().getFullYear();
---
<footer class="site-footer container">
  <div class="footer-top"><div><a href="/#index" class="brand" aria-label="Nalaro, beranda"><img src={site.logo} width="40" height="40" alt="" loading="lazy"/><span>nalaro</span></a><p>{site.tagline}</p>
    <div class="footer-order-links">
      <a href="https://order.nalaro.digital/form/" target="_blank" rel="noopener noreferrer">Form order <span aria-hidden="true">↗</span></a>
      {site.whatsapp && <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener noreferrer">Order via WhatsApp <span aria-hidden="true">↗</span></a>}
    </div>
  </div>
    <nav aria-label="Navigasi footer">{nav.map(item => <a href={`/#${item.id}`}>{item.label}</a>)}<a href="/#lab">Lab</a><a href="/#contact">Kontak</a></nav>
    <div class="footer-products">{products.filter(p => !p.isSlot).map((product, i) => <a href={product.url || `/#product-${["skripzy", "class", "enveely"][i]}`} target={product.url ? "_blank" : undefined} rel={product.url ? "noopener noreferrer" : undefined}>{product.name}<span aria-hidden="true">↗</span></a>)}</div>
  </div>
  <div class="footer-wordmark" aria-hidden="true" style="display: flex; align-items: center; overflow: visible;">
    <div style="display: block; white-space: nowrap;">NALARO<span style="font-size: .25em; -webkit-text-stroke: 0; color: var(--color-flare); vertical-align: top; margin-left: 20px; line-height: 1.7;">✳</span></div>
    <img src="/brand/nalaro-ghost-mascot.svg" alt="" style="height: 1.2em; width: auto; flex-shrink: 0; margin-left: auto;" />
  </div>
  <div class="footer-bottom">
    <div style="display: flex; gap: 20px; align-items: center; flex-wrap: wrap;">
      <span>© {year} Nalaro</span>
      <a href="/faq">FAQ</a>
      <a href="/privacy-policy">Privacy Policy</a>
      <a href="/terms-of-use">Terms of Use</a>
    </div>
    <div style="display: flex; gap: 20px; align-items: center;">
      <span class="desktop-only">{site.closing}</span>
      <a href="/#index">Kembali ke atas <span aria-hidden="true">↑</span></a>
    </div>
  </div>
</footer>

<style>
  .footer-order-links { display: flex; flex-wrap: wrap; gap: 8px 20px; margin-top: 20px; }
  .footer-order-links a { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; font-size: 13px; border-bottom: 1px solid var(--color-line); }
  .footer-order-links span { color: var(--color-flare); }
</style>
