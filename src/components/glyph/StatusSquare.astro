---
// StatusSquare — status marker per Desain.md §6
// Idea = empty square, Prototype = square with diagonal, Live = filled Bone, Graduated = filled Flare
interface Props {
  status: "Idea" | "Prototype" | "Live" | "Graduated" | "Coming Soon" | "Slot";
  size?: number;
  class?: string;
}

const { status, size = 10, class: className = "" } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 10 10"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  {status === "Idea" || status === "Coming Soon" || status === "Slot" ? (
    <rect x="0.5" y="0.5" width="9" height="9" stroke="currentColor" stroke-width="1" />
  ) : status === "Prototype" ? (
    <>
      <rect x="0.5" y="0.5" width="9" height="9" stroke="currentColor" stroke-width="1" />
      <line x1="0" y1="10" x2="10" y2="0" stroke="currentColor" stroke-width="1" />
    </>
  ) : status === "Live" ? (
    <rect width="10" height="10" fill="var(--color-bone)" />
  ) : status === "Graduated" ? (
    <rect width="10" height="10" fill="var(--color-flare)" />
  ) : null}
</svg>
