---
import { site } from "../../data/site";
import CornerTicks from "../layout/CornerTicks.astro";
import Gate from "../ui/Gate.astro";
import PipelineDiagram from "./PipelineDiagram.astro";
---

<section id="index" class="relative w-full min-h-[100svh] lg:h-[100svh] lg:min-h-[720px] pb-[48px] lg:pb-[40px] flex flex-col justify-end bg-[var(--color-ink)]" data-section="index">
  {/* The Hero Content */}
  <div class="hero-content grid-content relative flex-1 pt-[80px] lg:pt-[96px] pb-8 lg:pb-10 content-end">
    
    {/* Headline */}
    <div class="col-span-full lg:col-start-2 lg:col-span-7 flex flex-col gap-0 z-10 min-w-0">
      <h1 class="t-hero flex flex-col text-[var(--color-bone)] uppercase leading-[0.9]">
        <span class="hero-line w-cond relative overflow-hidden h-[1.1em]"><span class="block reveal-text">We build</span></span>
        <span class="hero-line w-max relative overflow-hidden h-[1.1em] text-[var(--color-bone)]" style="font-weight: 800;"><span class="block reveal-text delay-1">USEFUL</span></span>
        <span class="hero-line w-cond relative overflow-hidden h-[1.1em]">
          <span class="block reveal-text delay-2">
            digital <a href="#products" class="inline-block relative after:absolute after:bottom-[8px] after:left-0 after:w-full after:h-[3px] after:bg-current hover:after:h-[6px] focus-visible:after:h-[6px] after:transition-all after:duration-180 outline-none">products.</a>
          </span>
        </span>
      </h1>
      
      {/* Subtext */}
      <p class="hero-lede t-lede text-[var(--color-mute)] mt-6 lg:mt-8 max-w-[30ch] reveal-fade">
        {site.subheadline}
      </p>
    </div>

    {/* Diagram Frame (Desktop: Right Side, Mobile: Below Headline) */}
    <div class="hero-diagram col-span-full lg:col-start-8 lg:col-span-5 h-[280px] sm:h-[300px] lg:h-auto lg:absolute lg:top-[72px] lg:bottom-8 mt-10 lg:mt-0 relative border border-[var(--color-line)] z-0 reveal-fade delay-3 overflow-hidden">
      <div class="hidden lg:block">
        <CornerTicks color="var(--color-mute)" />
      </div>
      
      {/* Canvas container for Field (filled by script) */}
      <canvas id="hero-field" class="absolute inset-0 w-full h-full pointer-events-auto" aria-hidden="true"></canvas>
      
      {/* Data-driven ecosystem pipeline */}
      <div id="hero-pipeline" class="absolute inset-0 w-full h-full pointer-events-none flex items-center p-3 sm:p-6 lg:p-8">
        <PipelineDiagram />
      </div>

      <div class="absolute bottom-4 left-4 hidden lg:block">
        <span class="t-label text-[var(--color-mute)] bg-[var(--color-ink)] px-1">FIG.01 — EKOSISTEM</span>
      </div>
    </div>
  </div>

  {/* Gate Row (Always at bottom, above Dock) */}
  <div class="w-full lg:pl-[64px] relative z-20">
    <div class="grid grid-cols-1 md:grid-cols-3 border-t border-[var(--color-line)]">
      <div class="md:col-span-2 border-b md:border-b-0 md:border-r border-[var(--color-line)] min-w-0">
        <Gate href="#products" primary={true} class="border-0!">{site.ctaPrimary}</Gate>
      </div>
      <div class="min-w-0">
        <Gate href="#contact" class="border-0!">{site.ctaSecondary}</Gate>
      </div>
    </div>
  </div>
</section>

<style>
  /* These will be animated by GSAP in production, basic CSS fallbacks */
  .reveal-text {
    will-change: transform;
  }

  .hero-line {
    min-width: 0;
  }

  @media (max-width: 639px) {
    .hero-line {
      height: 1.08em;
    }
  }

  @media (max-width: 639px) and (max-height: 720px) {
    .hero-content {
      padding-top: 64px;
      padding-bottom: 20px;
    }

    .hero-lede {
      margin-top: 12px;
      font-size: 1rem;
      line-height: 1.5;
    }

    .hero-diagram {
      height: 160px;
      margin-top: 16px;
    }
  }
  /* Remove !important from Tailwind to allow our component to override via standard specificity */
  :global(.gate.border-0\!) {
    border-width: 0 !important;
  }
</style>
