---
import { pipelineStages } from "../../data/pipeline";
import { products } from "../../data/products";

const visibleProducts = products.filter((product) => !product.isSlot).slice(0, 3);
const stageX = [70, 190, 310, 430];
const productY = [190, 255, 320];
---

<div class="pipeline-diagram" role="img" aria-label="Alur Nalaro dari idea, experiment, lab, product, lalu bercabang ke produk Nalaro">
  <svg viewBox="0 0 640 400" class="w-full h-full" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
    <g class="pipeline-lines">
      <path d="M70 110 H190 H310 H430" />
      <path d="M430 110 V320" />
      {visibleProducts.map((_, index) => (
        <path d={`M430 ${productY[index]} H520`} />
      ))}
    </g>

    {pipelineStages.map((stage, index) => (
      <g>
        <rect
          x={stageX[index] - 5}
          y="105"
          width="10"
          height="10"
          class:list={["stage-node", stage.id === "product" ? "is-product" : ""]}
        />
        <text x={stageX[index]} y="88" text-anchor="middle" class="stage-label">
          {stage.label}
        </text>
        <text x={stageX[index]} y="136" text-anchor="middle" class="stage-index">
          {String(index + 1).padStart(2, "0")}
        </text>
      </g>
    ))}

    {visibleProducts.map((product, index) => (
      <g>
        <rect x="515" y={productY[index] - 5} width="10" height="10" class="terminal-node" />
        <text x="540" y={productY[index] - 8} class="product-code">{product.code}</text>
        <text x="540" y={productY[index] + 14} class="product-name">{product.name}</text>
      </g>
    ))}

    <rect x="426" y="182" width="8" height="16" class="signal-marker" />
  </svg>

  <ul class="sr-only">
    {pipelineStages.map((stage) => <li>{stage.label}</li>)}
    {visibleProducts.map((product) => <li>{product.code} {product.name}</li>)}
  </ul>
</div>

<style>
  .pipeline-diagram {
    width: 100%;
    height: 100%;
    color: var(--color-bone);
  }

  .pipeline-lines path {
    fill: none;
    stroke: var(--color-mute);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .stage-node,
  .terminal-node {
    fill: var(--color-ink);
    stroke: var(--color-bone);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .stage-node.is-product {
    fill: var(--color-flare);
    stroke: var(--color-flare);
  }

  .stage-label,
  .stage-index,
  .product-code,
  .product-name {
    font-family: var(--font-mono);
    dominant-baseline: middle;
  }

  .stage-label,
  .product-code {
    fill: var(--color-bone);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .08em;
  }

  .stage-index {
    fill: var(--color-mute);
    font-size: 10px;
    letter-spacing: .08em;
  }

  .product-name {
    fill: var(--color-mute);
    font-size: 12px;
  }

  .signal-marker {
    fill: var(--color-flare);
    animation: signal 6s steps(1, end) infinite;
  }

  @keyframes signal {
    0%, 18% { transform: translate(0, -80px); }
    19%, 42% { transform: translate(0, -15px); }
    43%, 66% { transform: translate(0, 50px); }
    67%, 100% { transform: translate(0, 115px); }
  }

  @media (max-width: 639px) {
    .product-name {
      font-size: 10px;
    }

    .stage-label,
    .product-code {
      font-size: 10px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .signal-marker {
      animation: none;
      transform: translate(0, 50px);
    }
  }
</style>
