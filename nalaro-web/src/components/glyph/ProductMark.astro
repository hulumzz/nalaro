---
// ProductMark — product visual representations as per Desain.md §10.2
// SVG primitive shapes, viewBox 160x160, 1px Bone strokes, 1 Flare element
interface Props {
  product: "skripzy" | "class" | "enveely";
  class?: string;
}

const { product, class: className = "" } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 160 160"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  {product === "skripzy" ? (
    <g stroke="var(--color-bone)" stroke-width="1">
      <line x1="20" y1="30" x2="140" y2="30" />
      <line x1="20" y1="50" x2="130" y2="50" />
      <line x1="20" y1="70" x2="140" y2="70" />
      <line x1="20" y1="90" x2="120" y2="90" />
      <line x1="20" y1="110" x2="140" y2="110" />
      <line x1="20" y1="130" x2="90" y2="130" />
      {/* Last line partly Flare, ends with blinking cursor */}
      <line x1="90" y1="130" x2="110" y2="130" stroke="var(--color-flare)" />
      <rect x="114" y="120" width="2" height="10" fill="var(--color-flare)" stroke="none" class="animate-blink" />
    </g>
  ) : product === "class" ? (
    <g>
      {/* 4x4 grid of 20px squares, some filled */}
      <g stroke="var(--color-bone)" stroke-width="1">
        {Array.from({ length: 4 }).map((_, r) =>
          Array.from({ length: 4 }).map((_, c) => (
            <rect
              x={30 + c * 20}
              y={30 + r * 20}
              width="20"
              height="20"
              fill={(r === 1 && c === 2) || (r === 2 && c === 0) ? "var(--color-bone)" : "none"}
            />
          ))
        )}
        {/* Flare filled square */}
        <rect x={70} y={70} width="20" height="20" fill="var(--color-flare)" stroke="none" />
      </g>
      {/* Path to score bar */}
      <path d="M90 80 H 120 V 40" stroke="var(--color-bone)" stroke-width="1" />
      <rect x="125" y="40" width="5" height="80" fill="var(--color-bone)" />
    </g>
  ) : product === "enveely" ? (
    <g class="enveely-group">
      {/* Base rectangle */}
      <rect x="30" y="50" width="100" height="60" stroke="var(--color-bone)" stroke-width="1" />
      {/* Bottom diagonals */}
      <path d="M30 110 L 80 80 L 130 110" stroke="var(--color-bone)" stroke-width="1" />
      {/* Top flap that rotates on hover */}
      <path class="enveely-flap" d="M30 50 L 80 80 L 130 50" stroke="var(--color-bone)" stroke-width="1" />
      {/* Flare seal */}
      <rect x="76" y="76" width="8" height="8" fill="var(--color-flare)" class="enveely-seal" />
    </g>
  ) : null}
</svg>

<style>
  .animate-blink {
    animation: blink 1s steps(1, end) infinite;
  }
  
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-blink {
      animation: none;
    }
  }

  /* Enveely hover effect */
  .enveely-flap {
    transform-origin: 80px 50px;
    transition: transform 0.4s var(--ease-out);
  }
  .enveely-seal {
    transition: transform 0.4s var(--ease-out), opacity 0.4s var(--ease-out);
  }
  
  /* Assume parent handles the hover state by applying a class or using group-hover in Tailwind */
  :global(.group:hover) .enveely-flap,
  :global(.group:focus-visible) .enveely-flap {
    transform: rotateX(150deg);
  }
  :global(.group:hover) .enveely-seal,
  :global(.group:focus-visible) .enveely-seal {
    opacity: 0;
  }
</style>
