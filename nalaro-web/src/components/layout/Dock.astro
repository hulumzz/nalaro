---
import BracketLink from "../ui/BracketLink.astro";
---

<div class="dock fixed bottom-0 left-0 w-full h-[48px] lg:h-[40px] bg-[var(--color-ink)] border-t border-[var(--color-line)] z-40 flex items-center justify-between lg:pl-[64px]">
  
  {/* Left: About indicator */}
  <div class="px-4 lg:px-6 shrink-0 flex items-center h-full border-r border-transparent lg:border-[var(--color-line)]">
    <span id="dock-section" class="t-label text-[var(--color-mute)] whitespace-nowrap">00 / 06 — INDEX</span>
  </div>

  {/* Center (Desktop): Scroll Progress */}
  <div class="hidden lg:flex flex-1 items-center h-full px-6 gap-4">
    <div class="relative w-full h-[1px] bg-[var(--color-line)]">
      <div id="dock-tick" class="absolute top-[-4px] left-0 -translate-x-1/2 w-[2px] h-[10px] bg-[var(--color-flare)] will-change-[left]"></div>
    </div>
    <span id="dock-pct" class="t-label text-[var(--color-mute)] tabular-nums shrink-0 w-8 text-right">0%</span>
  </div>

  {/* Right: CTA */}
  <div class="px-4 lg:px-6 h-full flex items-center justify-end shrink-0" id="dock-cta">
    <BracketLink href="#contact" class="text-[var(--color-bone)]">Build With Nalaro</BracketLink>
  </div>
</div>

<style>
  /* Hidden when Contact section is active */
  :global(.contact-active) #dock-cta {
    opacity: 0;
    pointer-events: none;
  }
</style>
